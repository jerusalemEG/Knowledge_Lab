@echo off
chcp 65001 >nul
title رفع دائم للموقع على Vercel مدى الحياة
echo ======================================================================
echo          رفع موقع شبكة المعرفة والنواميس الباطنية بشكل دائم
echo ======================================================================
echo.
echo سيتم الآن فتح المتصفح لتسجيل الدخول بحسابك المجاني (Google أو GitHub).
echo بعد تسجيل الدخول لمرة واحدة فقط، سيكون الموقع دائم 24/7 للأبد بدون انتهاء!
echo.
pause
echo.
echo [1/2] جاري تسجيل الدخول...
call npx vercel login
echo.
echo [2/2] جاري النشر الدائم على Vercel...
call npx vercel deploy ./website --prod --yes
echo.
echo ======================================================================
echo تم الرفع بنجاح! الموقع الآن دائم للأبد ولا ينتهي صلاحيته أبداً.
echo ======================================================================
pause
exit
